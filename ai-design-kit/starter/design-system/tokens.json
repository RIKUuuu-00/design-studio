{
  "$description": "デザイントークンの正。tokens.css はこの写し。値を変えたら両方を更新する。",
  "color": {
    "bg": "#f7f7f5",
    "surface": "#ffffff",
    "surface-muted": "#f0f0ec",
    "border": "#dcdcd5",
    "text": "#1c1c1a",
    "text-muted": "#66665f",
    "primary": "#1f4fd1",
    "primary-hover": "#1a43b2",
    "primary-weak": "#e7edfb",
    "on-primary": "#ffffff",
    "success": "#1d7a46",
    "warning": "#a15c00",
    "danger": "#c0362c",
    "danger-weak": "#fbe9e7",
    "focus": "#1f4fd1"
  },
  "font": {
    "sans": "\"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic UI\", \"Meiryo\", system-ui, sans-serif",
    "mono": "ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
  },
  "text": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem" },
  "leading": { "tight": 1.3, "normal": 1.6 },
  "weight": { "regular": 400, "bold": 700 },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px" },
  "radius": { "sm": "4px", "md": "8px", "lg": "12px", "full": "999px" },
  "container-max": "1200px",
  "gutter": "16px",
  "slides": {
    "$description": "資料トラックはテンプレのテーマが正。ここは図解を個別に組むときの補助ルール。",
    "min_font_pt": 10,
    "text_margin_ratio": 0.1,
    "colors": "テーマ色（accent1〜6, text1/2, bg1/2）のみ。RGB 直指定はしない"
  }
}
